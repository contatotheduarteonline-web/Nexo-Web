# ==========================================
# PROJETO FARDA - PERSISTÊNCIA SUPABASE
# ==========================================

# 1. DATABASE_URL: String de conexão PostgreSQL do Supabase (Transaction Pooler ou Direct Connection)
# Formato: postgresql://postgres.[project-ref]:[SUA_SENHA]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x
DATABASE_URL=""

# 2. SUPABASE_URL: URL do seu projeto no Supabase
# Formato: https://[project-ref].supabase.co
SUPABASE_URL=""

# 3. SUPABASE_SECRET_KEY: Chave secreta / Service Role Key do Supabase (NUNCA expor no cliente)
SUPABASE_SECRET_KEY=""

# 4. SUPABASE_STORAGE_BUCKET: Nome do Bucket no Supabase Storage para fotos de perfil
SUPABASE_STORAGE_BUCKET="avatars"

# ==========================================
# CONFIGURAÇÕES ADICIONAIS
# ==========================================

# GEMINI_API_KEY: Injetada automaticamente pelo Google AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL da aplicação
APP_URL="MY_APP_URL"

# RESEND_API_KEY / SMTP: Notificações por e-mail (Opcional)
RESEND_API_KEY=""
EMAIL_FROM="Projeto Farda <contato@projetofarda.com.br>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
